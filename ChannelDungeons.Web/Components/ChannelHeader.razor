<header class="channel-header">
    <button class="sidebar-toggle"
            aria-label="Toggle sidebar"
            aria-expanded="@(SidebarVisible ? "true" : "false")"
            @onclick="OnToggleSidebar">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M 15.41 16.59 L 10.83 12 L 15.41 7.41 L 14 6 L 8 12 L 14 18 L 15.41 16.59 Z M 10 13 H 21 V 11 H 10" fill="currentColor"/>
        </svg>
    </button>
    <div class="channel-name">
        <span class="channel-hash" aria-hidden="true">#</span>
        <span id="current-channel">@ChannelId</span>
    </div>
    <div class="channel-description">@Description</div>
</header>

@code {
    [Parameter] public string ChannelId { get; set; } = string.Empty;
    [Parameter] public string Description { get; set; } = string.Empty;
    [Parameter] public bool SidebarVisible { get; set; }
    [Parameter] public EventCallback OnToggleSidebar { get; set; }
}
